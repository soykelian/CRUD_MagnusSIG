# ==============================================================================
# Magnus SIG - Plantilla de variables de entorno locales (.env.example)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto y ajusta los valores:
#   copy .env.example .env
# NUNCA compartas ni subas tu archivo '.env' a Git.
# ==============================================================================

# Configuración de MySQL local (BD: magnussig_inventario)
MYSQL_DATABASE=magnussig_inventario
MYSQL_USER=root
MYSQL_PASSWORD=tu_contraseña_local_mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Alternativa: usar SQLite local si no tienes MySQL instalado (1 = activado, 0 = desactivado)
# DJANGO_USE_SQLITE=1

# Opciones de Django (opcionales para desarrollo)
# DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=tu_clave_secreta_aqui
